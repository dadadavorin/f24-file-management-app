# Docker Compose — ports exposed on the host
NGINX_PORT=8080
POSTGRES_PORT=5432
VITE_PORT=5173

# PostgreSQL, and the matching Laravel DB_* connection the app container uses
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=secret

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret
